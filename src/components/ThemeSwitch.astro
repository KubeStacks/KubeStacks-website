---
/** System, Light or Dark, as in the app's Appearance menu. */
import { icon } from '../lib/icons'

const options = [
  { value: 'system', label: 'System', icon: icon('monitor') },
  { value: 'light', label: 'Light', icon: icon('sun') },
  { value: 'dark', label: 'Dark', icon: icon('moon') },
] as const
---

<div class="switch" role="radiogroup" aria-label="Appearance" data-theme-switch>
  <span class="thumb" aria-hidden="true"></span>
  {options.map((o) => (
    <button
      type="button"
      role="radio"
      aria-checked="false"
      aria-label={o.label}
      title={o.label}
      data-value={o.value}
      set:html={o.icon}
    />
  ))}
</div>

<style>
  .switch {
    --size: 28px;
    position: relative;
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    background: var(--tint);
  }

  /* Placed from the preference the <head> script set, so it's right before any script runs. */
  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: var(--size);
    height: var(--size);
    border-radius: 999px;
    background: var(--surface-3);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--shadow-xs);
    transition: transform 320ms var(--ease-out);
  }

  :global(:root[data-theme-pref='light']) .thumb {
    transform: translateX(var(--size));
  }

  :global(:root[data-theme-pref='dark']) .thumb {
    transform: translateX(calc(var(--size) * 2));
  }

  button {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    transition: color 150ms ease;
  }

  button:hover,
  button[aria-checked='true'] {
    color: var(--text-1);
  }

  button :global(svg) {
    width: 15px;
    height: 15px;
  }
</style>

<script>
  import '../scripts/theme'
</script>
