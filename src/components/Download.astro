---
import DocLink from './DocLink.astro'
import KubeStacksLogo from './logos/KubeStacksLogo.astro'
import GithubMark from './logos/GithubMark.astro'
import { doc } from '../lib/docs'
import { icon } from '../lib/icons'
import { escapeHtml } from '../lib/html'
import { server, site } from '../lib/site'
import { latestAtBuild } from '../lib/latest-release'
import { LATEST_URL, fileSize, fileUrl, releaseDay, releasePage, versionTag } from '../lib/releases'

// Links to the latest release's files, as of the build; the page checks again when it loads.
const dl = await latestAtBuild()

const linux = [
  { kind: 'appimage', label: 'AppImage' },
  { kind: 'deb', label: '.deb' },
  { kind: 'rpm', label: '.rpm' },
] as const

const build =
  'git clone https://github.com/KubeStacks/KubeStacks && cd KubeStacks && npm ci && npm run dist'

// As docs/server.md in the app has them. The chart and the image are released with the app,
// under its version, so these always get the latest.
const helm = `helm install kubestacks ${server.chart} \\
  --namespace kubestacks --create-namespace
kubectl port-forward --namespace kubestacks service/kubestacks 8080:80`

/**
 * A command a line at a time, so a line too long for its box wraps under itself, indented,
 * rather than under the next. Copying it gives the lines as they are.
 */
const lines = (command: string) =>
  command
    .split('\n')
    .map((line, i, all) => `<span>${escapeHtml(line)}${i < all.length - 1 ? '\n' : ''}</span>`)
    .join('')

const docker = `docker run --rm -p 8080:8080 \\
  -v "$PWD/kubeconfig:/kubeconfig:ro" -e KUBECONFIG=/kubeconfig \\
  ${server.image}`
---

<section class="download" id="download">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="head">
      <KubeStacksLogo size={64} class="mark" />
      <h2 class="h2">Get KubeStacks.</h2>
      <p class="lead">
        Free and open source under the Apache 2.0 license, with no telemetry. Download it for your
        computer, or install it in your cluster for everyone on your team.
      </p>
      <p class="status" data-dl-status hidden={!dl}>
        <span
          class="pill"
          data-health="healthy"
          set:html={`${icon('circle-check', 2.25)}<span>Latest</span>`}
        />
        <span>
          Version <b data-dl-version>{versionTag(dl)}</b>, released{' '}
          <span data-dl-date>{releaseDay(dl)}</span>.
        </span>
        <a href={releasePage(dl)} data-dl-notes target="_blank" rel="noopener">
          Release notes
        </a>
        <a href={fileUrl(dl, 'sums')} data-dl="sums" target="_blank" rel="noopener">
          SHA-256 checksums
        </a>
        <DocLink path="get-started/desktop" section="verify-your-download">
          Verify your download
        </DocLink>
      </p>
      <p class="status" data-dl-fallback hidden={!!dl}>
        Every installer is on
        <a href={LATEST_URL} target="_blank" rel="noopener">
          the latest GitHub release
        </a>
        .
      </p>
    </div>

    <div class="track">
      <h3>On your computer</h3>
      <span class="t-note">
        <DocLink path="get-started/desktop" />
      </span>
    </div>

    <ul class="platforms">
      <li data-platform="mac">
        <div class="p-head">
          <h4>macOS</h4>
          <span class="p-yours">Your system</span>
        </div>
        <p class="p-info">macOS 12 or later. Signed and notarized by Apple.</p>
        <div class="p-btns">
          <a
            class="btn btn-secondary p-btn"
            href={fileUrl(dl, 'mac.dmg.arm64')}
            data-dl="mac.dmg.arm64"
            data-arch="arm64"
          >
            <Fragment set:html={icon('download')} />
            Apple silicon
            <span class="size" data-dl-size="mac.dmg.arm64">
              {fileSize(dl, 'mac.dmg.arm64')}
            </span>
          </a>
          <a
            class="btn btn-secondary p-btn"
            href={fileUrl(dl, 'mac.dmg.x64')}
            data-dl="mac.dmg.x64"
            data-arch="x64"
          >
            <Fragment set:html={icon('download')} />
            Intel
            <span class="size" data-dl-size="mac.dmg.x64">
              {fileSize(dl, 'mac.dmg.x64')}
            </span>
          </a>
        </div>
        <p class="p-more">
          Disk images (.dmg). Also as .zip for{' '}
          <a href={fileUrl(dl, 'mac.zip.arm64')} data-dl="mac.zip.arm64">
            Apple silicon
          </a>{' '}
          and{' '}
          <a href={fileUrl(dl, 'mac.zip.x64')} data-dl="mac.zip.x64">
            Intel
          </a>
          .
        </p>
      </li>

      <li data-platform="windows">
        <div class="p-head">
          <h4>Windows</h4>
          <span class="p-yours">Your system</span>
        </div>
        <p class="p-info">Windows 10 or later, on x64 and arm64.</p>
        <div class="p-btns">
          <a
            class="btn btn-secondary p-btn"
            href={fileUrl(dl, 'windows.exe')}
            data-dl="windows.exe"
            data-arch="any"
          >
            <Fragment set:html={icon('download')} />
            Installer
            <span class="size" data-dl-size="windows.exe">
              {fileSize(dl, 'windows.exe')}
            </span>
          </a>
        </div>
        <p class="p-more">
          Not code-signed yet. If Windows warns you, choose More info, then Run anyway.
        </p>
      </li>

      <li data-platform="linux">
        <div class="p-head">
          <h4>Linux</h4>
          <span class="p-yours">Your system</span>
        </div>
        <p class="p-info">A recent 64-bit distribution.</p>
        <table class="l-table">
          <thead>
            <tr>
              <th>
                <span class="visually-hidden">Format</span>
              </th>
              <th>x64</th>
              <th>arm64</th>
            </tr>
          </thead>
          <tbody>
            {linux.map((f) => (
              <tr>
                <th>{f.label}</th>
                {(['x64', 'arm64'] as const).map((a) => (
                  <td>
                    <a
                      href={fileUrl(dl, `linux.${f.kind}.${a}`)}
                      data-dl={`linux.${f.kind}.${a}`}
                      data-arch={a}
                    >
                      <Fragment set:html={icon('download')} />
                      <span data-dl-size={`linux.${f.kind}.${a}`}>
                        {fileSize(dl, `linux.${f.kind}.${a}`, 'Download')}
                      </span>
                    </a>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </li>
    </ul>

    <div class="extra">
      <div class="build">
        <div class="b-label">
          <span>
            Or build it yourself <span class="b-needs">with Node.js 24 or later</span>
          </span>
          <DocLink path="reference/build-from-source">Build from source</DocLink>
        </div>
        <div class="b-cmd">
          <code id="build-cmd">{build}</code>
          <button
            type="button"
            class="copy"
            data-copy="#build-cmd"
            aria-label="Copy the build commands"
          >
            <span class="i-copy" set:html={icon('copy')} />
            <span class="i-done" set:html={icon('check')} />
          </button>
        </div>
      </div>
      <dl class="reqs">
        <div>
          <dt>Kubernetes</dt>
          <dd>1.25 or later</dd>
        </div>
        <div>
          <dt>kubectl</dt>
          <dd>Not needed</dd>
        </div>
        <div>
          <dt>Helm</dt>
          <dd>Only to change releases</dd>
        </div>
      </dl>
    </div>

    <div class="track" id="install-cluster">
      <h3>In your cluster</h3>
      <span class="t-note">
        <DocLink path="server/overview" />
      </span>
    </div>

    <ul class="servers">
      <li>
        <div class="p-head">
          <h4>Helm chart</h4>
          <span class="s-ic" set:html={icon('ship-wheel')} />
        </div>
        <p class="p-info">
          Any cluster on Kubernetes 1.25 or later. Then open localhost:8080 and sign in with a
          token.
        </p>
        <DocLink path="server/install" />
        <div class="cmd">
          <pre id="helm-cmd" set:html={lines(helm)} />
          <button
            type="button"
            class="copy"
            data-copy="#helm-cmd"
            aria-label="Copy the Helm commands"
          >
            <span class="i-copy" set:html={icon('copy')} />
            <span class="i-done" set:html={icon('check')} />
          </button>
        </div>
        <p class="p-more">
          Then give it{' '}
          <a href={doc('server/expose')} target="_blank" rel="noopener">
            an address of its own
          </a>
          , sign people in with{' '}
          <a href={doc('server/auth/single-sign-on')} target="_blank" rel="noopener">
            single sign-on
          </a>
          , or see{' '}
          <a href={doc('server/helm-values')} target="_blank" rel="noopener">
            every setting
          </a>
          .
        </p>
      </li>

      <li>
        <div class="p-head">
          <h4>Container image</h4>
          <span class="s-ic" set:html={icon('container')} />
        </div>
        <p class="p-info">
          Without Kubernetes, on a machine of its own: KubeStacks shows a cluster from a kubeconfig.
        </p>
        <DocLink path="server/docker" />
        <div class="cmd">
          <pre id="docker-cmd" set:html={lines(docker)} />
          <button
            type="button"
            class="copy"
            data-copy="#docker-cmd"
            aria-label="Copy the Docker command"
          >
            <span class="i-copy" set:html={icon('copy')} />
            <span class="i-done" set:html={icon('check')} />
          </button>
        </div>
        <p class="p-more">
          For linux/amd64 and arm64. Each release is signed with a build provenance attestation,
          which you can{' '}
          <a href={doc('server/install', 'verify-the-image')} target="_blank" rel="noopener">
            verify
          </a>
          .
        </p>
      </li>
    </ul>

    <div class="cta">
      <a class="btn btn-primary" href={site.repo} target="_blank" rel="noopener">
        <GithubMark size={17} />
        Star on GitHub
      </a>
      <a class="btn btn-secondary" href={doc()} target="_blank" rel="noopener">
        <Fragment set:html={icon('book-open')} />
        Read the docs
      </a>
      <a class="btn btn-secondary" href={site.releases} target="_blank" rel="noopener">
        All releases
        <Fragment set:html={icon('arrow-up-right')} />
      </a>
    </div>
  </div>
  <script is:inline type="application/json" id="downloads-data" set:html={JSON.stringify(dl)} />
</section>

<style>
  .download {
    position: relative;
    padding-block: clamp(72px, 10vw, 140px);
    isolation: isolate;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--download-glow);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%);
    mask-image: linear-gradient(to bottom, transparent, #000 18%);
  }

  .head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .head :global(.mark) {
    width: 64px;
    height: 64px;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 12px 24px rgb(57 135 229 / 0.45));
  }

  .head .lead {
    margin-inline: auto;
  }

  .status {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 14px;
    font-size: 0.875rem;
    color: var(--text-2);
  }

  .status[hidden] {
    display: none;
  }

  .status b {
    color: var(--text-1);
    font-weight: 600;
  }

  .status a {
    color: var(--text-1);
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }

  .status a:hover {
    text-decoration-color: currentColor;
  }

  /* A label over each way to get KubeStacks, with a rule running to its note. */
  .track {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .track::after {
    content: '';
    order: 1;
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .track h3 {
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    white-space: nowrap;
  }

  .t-note {
    order: 2;
    font-size: 0.8125rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  #install-cluster {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platforms > li,
  .servers > li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 200ms ease;
  }

  .platforms > li[data-yours] {
    box-shadow:
      inset 0 0 0 1px rgb(57 135 229 / 0.55),
      0 20px 60px -30px rgb(57 135 229 / 0.6);
  }

  .p-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .p-head h4 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .p-yours {
    display: none;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent-strong);
  }

  [data-yours] .p-yours {
    display: inline;
  }

  .p-info {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .p-btns {
    display: grid;
    gap: 8px;
    margin-top: 6px;
  }

  .p-btn {
    width: 100%;
    justify-content: flex-start;
  }

  .p-btn .size {
    margin-left: auto;
    font: 500 12px/1 var(--font-mono);
    color: var(--text-3);
  }

  /* Your platform's file, for your chip, is the one to press. */
  [data-yours] .p-btn[data-pick] {
    background: var(--accent);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 8px 24px -10px rgb(57 135 229 / 0.6);
  }

  [data-yours] .p-btn[data-pick]:hover {
    background: var(--accent-hover);
  }

  [data-yours] .p-btn[data-pick] .size {
    color: rgb(255 255 255 / 0.75);
  }

  .p-more {
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-3);
  }

  .p-more a {
    color: var(--text-2);
    text-underline-offset: 3px;
  }

  .l-table {
    width: 100%;
    margin-top: 6px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .l-table th,
  .l-table td {
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    font-weight: 500;
  }

  .l-table thead th {
    padding-top: 0;
    font: 500 0.75rem/1.4 var(--font-mono);
    color: var(--text-3);
  }

  .l-table tbody th {
    color: var(--text-1);
  }

  .l-table a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    margin-left: -8px;
    border-radius: 7px;
    font: 500 12px/1 var(--font-mono);
    color: var(--text-2);
    text-decoration: none;
  }

  .l-table a:hover {
    background: var(--tint-strong);
    color: var(--text-1);
  }

  .l-table a[data-pick] {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .l-table a :global(svg) {
    width: 14px;
    height: 14px;
  }

  .servers {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each way in a row of its own, so its command has the room to keep to its lines. */
  .servers > li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    grid-template-rows: auto auto auto 1fr;
    justify-items: start;
    gap: 10px 32px;
  }

  .servers .p-head {
    justify-self: stretch;
  }

  .servers .cmd {
    grid-column: 2;
    grid-row: 1 / span 4;
    justify-self: stretch;
    align-self: center;
    margin-top: 0;
  }

  .s-ic {
    color: var(--accent-strong);
  }

  .s-ic :global(svg) {
    width: 20px;
    height: 20px;
  }

  .cmd {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 6px;
    padding: 4px 4px 4px 14px;
    border-radius: 10px;
    background: var(--code-bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .cmd pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding-block: 7px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .cmd pre :global(span) {
    display: block;
    padding-left: 4ch;
    text-indent: -4ch;
  }

  .extra {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px;
    margin-top: 16px;
  }

  .build,
  .reqs {
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    min-width: 0;
  }

  .b-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 12px;
    margin-bottom: 12px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .b-needs {
    color: var(--text-3);
    font-weight: 400;
  }

  .b-cmd {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 4px 4px 4px 14px;
    border-radius: 10px;
    background: var(--code-bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .b-cmd code {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-2);
    padding-block: 7px;
  }

  .copy {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }

  .copy:hover {
    background: var(--surface-3);
    color: var(--text-1);
  }

  .copy :global(svg) {
    width: 16px;
    height: 16px;
  }

  .copy .i-done,
  .copy[data-done] .i-copy {
    display: none;
  }

  .copy[data-done] .i-done {
    display: grid;
    color: var(--good-text);
  }

  .reqs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    align-content: center;
  }

  .reqs dt {
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .reqs dd {
    margin: 4px 0 0;
    font-size: 0.9375rem;
  }

  .cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(40px, 5vw, 56px);
  }

  @media (max-width: 900px) {
    .platforms,
    .extra,
    .servers > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .servers > li {
      grid-template-rows: none;
    }
    .servers .cmd {
      grid-column: auto;
      grid-row: auto;
      margin-top: 6px;
    }
  }

  @media (max-width: 480px) {
    .reqs {
      grid-template-columns: minmax(0, 1fr);
    }
    .t-note {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/copy'
</script>
