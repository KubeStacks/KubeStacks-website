---
/** Three stacked layers: the KubeStacks mark, as in the app's sidebar. */
interface Props {
  size?: number
  class?: string
}
const { size = 28, class: className } = Astro.props
const id = `logo-${Math.random().toString(36).slice(2, 8)}`
---

<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" class={className}>
  <defs>
    <linearGradient id={`${id}-a`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6fb1ff"></stop>
      <stop offset="1" stop-color="#2a6fd6"></stop>
    </linearGradient>
    <linearGradient id={`${id}-b`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4d8fe8"></stop>
      <stop offset="1" stop-color="#1d4f9e"></stop>
    </linearGradient>
  </defs>
  <path
    d="M16 19.5 4.5 13.8 16 8.1l11.5 5.7z"
    fill={`url(#${id}-b)`}
    opacity="0.45"
    transform="translate(0 6)"
  ></path>
  <path
    d="M16 19.5 4.5 13.8 16 8.1l11.5 5.7z"
    fill={`url(#${id}-b)`}
    opacity="0.75"
    transform="translate(0 3)"
  ></path>
  <path d="M16 19.5 4.5 13.8 16 8.1l11.5 5.7z" fill={`url(#${id}-a)`}></path>
</svg>
