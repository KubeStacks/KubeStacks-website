---
import KubeStacksLogo from './logos/KubeStacksLogo.astro'
import GithubMark from './logos/GithubMark.astro'
import ThemeSwitch from './ThemeSwitch.astro'
import { site } from '../lib/site'
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a href="#top" class="brand" aria-label="KubeStacks home">
      <KubeStacksLogo size={26} />
      <span>KubeStacks</span>
    </a>
    <nav aria-label="Sections" class="links">
      <a href="#app">The app</a>
      <a href="#features">Features</a>
      <a href="#story">Story</a>
      <a href="#download">Download</a>
    </nav>
    <ThemeSwitch />
    <a class="gh" href={site.repo} target="_blank" rel="noopener">
      <GithubMark size={17} />
      <span>GitHub</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    transition:
      background-color 240ms ease,
      box-shadow 240ms ease,
      backdrop-filter 240ms ease;
  }

  .nav[data-scrolled] {
    background: var(--nav-bg);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    box-shadow: 0 1px 0 var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .links {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .links a,
  .gh {
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .links a:hover,
  .gh:hover {
    color: var(--text-1);
    background: var(--tint-strong);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-1);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  @media (max-width: 720px) {
    .links {
      display: none;
    }
    .nav-inner > :global(.switch) {
      margin-left: auto;
    }
  }

  @media (max-width: 380px) {
    .gh span {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/nav'
</script>
