---
import { Image } from 'astro:assets'
import dark from '../assets/screenshots/overview-dark.png'
import light from '../assets/screenshots/overview-light.png'
import { icon } from '../lib/icons'
---

<section class="themes">
  <div class="wrap">
    <div class="head">
      <h2 class="h2">
        Light and dark. <span class="dim">It follows your system, or you pick.</span>
      </h2>
      <p class="lead">
        Status colors are kept for health and always come with an icon and a label. Charts use a
        palette checked for color blindness, in both themes. This page switches too, from the top.
      </p>
    </div>

    <div class="compare" data-compare style="--split: 50%">
      <Image
        src={light}
        alt="The overview in the light theme."
        widths={[960, 1440, 2000, 2880]}
        sizes="(max-width: 1320px) 100vw, 1240px"
        loading="lazy"
        class="img light"
        draggable="false"
      />
      <div class="dark-clip">
        <Image
          src={dark}
          alt="The same overview in the dark theme."
          widths={[960, 1440, 2000, 2880]}
          sizes="(max-width: 1320px) 100vw, 1240px"
          loading="lazy"
          class="img"
          draggable="false"
        />
      </div>
      <div class="handle" aria-hidden="true">
        <span class="knob">
          <Fragment set:html={icon('moon')} />
          <Fragment set:html={icon('sun')} />
        </span>
      </div>
      <input
        id="theme-split"
        type="range"
        min="0"
        max="100"
        value="50"
        step="0.1"
        aria-label="Drag to compare the dark and light themes"
      />
    </div>
  </div>
</section>

<style>
  .themes {
    padding-block: clamp(48px, 7vw, 96px);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 1.5rem 4rem;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .head .lead {
    font-size: 1.0625rem;
  }

  .compare {
    position: relative;
    aspect-ratio: 1440 / 900;
    max-width: 100%;
    border-radius: clamp(10px, 1.2vw, 16px);
    overflow: hidden;
    box-shadow: var(--shadow-window);
    user-select: none;
    touch-action: pan-y;
  }

  .compare :global(.img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dark-clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: rgb(255 255 255 / 0.9);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.25),
      0 0 24px rgb(57 135 229 / 0.6);
    pointer-events: none;
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 99px;
    background: #fff;
    color: #0b0b0f;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
    transform: translate(-50%, -50%);
  }

  .knob :global(svg) {
    width: 15px;
    height: 15px;
  }

  input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .compare:has(input:focus-visible) .knob {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import '../scripts/compare'
</script>
