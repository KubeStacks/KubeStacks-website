---
/**
 * A feature: its name, what it does and its page in the docs, above a working piece of the
 * app (the default slot), which the tile's edge cuts off.
 */
import DocLink from '../DocLink.astro'
import type { DocPath } from '../../lib/docs'

interface Props {
  /** Columns of the 12-column grid. */
  span: 5 | 7
  docs: DocPath
}

const { span, docs } = Astro.props
---

<article class:list={['tile', `span-${span}`]}>
  <div class="copy">
    <h3>
      <slot name="title" />
    </h3>
    <p>
      <slot name="text" />
    </p>
    <DocLink path={docs} />
  </div>
  <slot />
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 24px;
    padding: 28px 28px 0;
    border-radius: 18px;
    background:
      radial-gradient(120% 80% at 0% 0%, var(--tile-tint), transparent 60%), var(--tile-bg);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }

  .span-7 {
    grid-column: span 7;
  }

  .span-5 {
    grid-column: span 5;
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: 8px;
    max-width: 30rem;
  }

  .copy > :global(.doc-link) {
    margin-top: 2px;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  h3 :global(.kbd) {
    height: 24px;
    min-width: 24px;
    margin-right: 2px;
    font-size: 13px;
    color: var(--text-1);
  }

  h3 :global(.kbd + .kbd) {
    margin-right: 6px;
  }

  p {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 1080px) {
    .span-7,
    .span-5 {
      grid-column: span 12;
    }
  }

  @media (max-width: 560px) {
    .tile {
      padding: 22px 18px 0;
    }
  }
</style>
