---
/** The app's merged log view; scripts/features/logs.ts writes the lines. */
const chips = [
  { key: 'error', label: 'Errors', count: 4, dot: 'var(--critical)' },
  { key: 'warn', label: 'Warnings', count: 29, dot: 'var(--warn)' },
  { key: 'hqnnn', label: 'hqnnn', count: 19, dot: 'var(--series-1)' },
  { key: 'lnk52', label: 'lnk52', count: 242, dot: 'var(--series-2)' },
  { key: 'pwkd2', label: 'pwkd2', count: 19, dot: 'var(--series-3)' },
]
---

<div class="demo" data-logs>
  <div class="chips" aria-hidden="true">
    {chips.map((c) => (
      <span class="chip">
        <i class="dot" style={`background: ${c.dot}`} />
        {c.label} <b data-count={c.key}>{c.count}</b>
      </span>
    ))}
  </div>
  <div class="lines">
    <ol aria-label="Log lines from the checkout deployment"></ol>
  </div>
</div>

<style>
  .demo {
    --demo-h: 360px;
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--code-bg);
  }

  /* One line, whatever the counts grow to; it fades out at the edge on narrow screens. */
  .chips {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
    -webkit-mask-image: linear-gradient(to right, #000 90%, transparent);
    mask-image: linear-gradient(to right, #000 90%, transparent);
  }

  .chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border-radius: 99px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--text-2);
    font-size: 12px;
  }

  .chip b {
    font-weight: 500;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  /* The lines sit at the bottom, and the oldest fade out at the top. */
  .lines {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 6px 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol :global(li) {
    display: flex;
    gap: 10px;
    padding: 2px 14px;
    white-space: nowrap;
    color: var(--text-2);
    line-height: 1.6;
  }

  ol :global(li.new) {
    animation: line-in 380ms var(--ease-out);
  }

  @keyframes line-in {
    from {
      opacity: 0;
    }
  }

  ol :global(li[data-level='warn']) {
    background: rgb(250 178 25 / 0.07);
  }

  ol :global(li[data-level='error']) {
    background: rgb(208 59 59 / 0.1);
  }

  ol :global(.l-time) {
    color: var(--text-3);
  }

  ol :global(.l-pod) {
    padding-left: 8px;
    border-left: 2px solid;
  }

  ol :global(.l-level) {
    font-weight: 600;
    color: var(--text-1);
  }

  ol :global([data-level='warn'] .l-level) {
    color: var(--warn-text);
  }

  ol :global([data-level='error'] .l-level),
  ol :global([data-level='error'] .l-msg) {
    color: var(--critical-text);
  }

  ol :global(.l-msg) {
    color: var(--text-1);
  }

  ol :global(.l-kv) {
    color: var(--text-3);
  }
</style>

<script>
  import '../../scripts/features/logs'
</script>
