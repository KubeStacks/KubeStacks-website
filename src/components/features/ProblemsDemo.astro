---
/** The app's workloads list, failing first; scripts/features/problems.ts keeps it moving. */
import { icon, pill, type Health, type IconName } from '../../lib/icons'

const KIND_ICONS: Record<string, IconName> = {
  Job: 'list-checks',
  Deployment: 'layers',
  StatefulSet: 'boxes',
}

const workloads: {
  name: string
  ns: string
  kind: string
  health: Health
  label: string
  pods: string
}[] = [
  {
    name: 'db-migrate',
    ns: 'batch',
    kind: 'Job',
    health: 'critical',
    label: 'Failed',
    pods: '0/1 done',
  },
  {
    name: 'recommendations',
    ns: 'shop',
    kind: 'Deployment',
    health: 'critical',
    label: 'Unavailable',
    pods: '0/1',
  },
  {
    name: 'checkout',
    ns: 'shop',
    kind: 'Deployment',
    health: 'warning',
    label: 'Degraded',
    pods: '1/3',
  },
  {
    name: 'redis',
    ns: 'data',
    kind: 'StatefulSet',
    health: 'warning',
    label: 'Degraded',
    pods: '1/2',
  },
  {
    name: 'backfill',
    ns: 'batch',
    kind: 'Job',
    health: 'progressing',
    label: 'Running',
    pods: '0/1 done',
  },
  { name: 'cart', ns: 'shop', kind: 'Deployment', health: 'healthy', label: 'Ready', pods: '2/2' },
  {
    name: 'coredns',
    ns: 'kube-system',
    kind: 'Deployment',
    health: 'healthy',
    label: 'Ready',
    pods: '2/2',
  },
  {
    name: 'grafana',
    ns: 'monitoring',
    kind: 'Deployment',
    health: 'healthy',
    label: 'Ready',
    pods: '1/1',
  },
]
---

<div class="demo" data-problems aria-label="A workloads list that re-sorts as statuses change">
  <div class="head" aria-hidden="true">
    <span>Name</span>
    <span class="kind">Type</span>
    <span>Status</span>
    <span class="pods">Pods</span>
  </div>
  <ol>
    {workloads.map((w) => (
      <li data-name={w.name} data-health={w.health}>
        <span class="name">
          <b>{w.name}</b>
          <small>{w.ns}</small>
        </span>
        <span class="kind">
          <Fragment set:html={icon(KIND_ICONS[w.kind]!)} />
          {w.kind}
        </span>
        <span class="c-status" set:html={pill(w.health, w.label)} />
        <span class="c-pods pods">{w.pods}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .demo {
    --demo-h: 340px;
    -webkit-mask-image: linear-gradient(to bottom, #000 75%, transparent);
    mask-image: linear-gradient(to bottom, #000 75%, transparent);
  }

  .head,
  li {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.1fr) minmax(0, 1.2fr) 64px;
    align-items: center;
    gap: 12px;
    padding-inline: 18px;
  }

  .head {
    height: 36px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    height: 50px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }

  li[data-changed] {
    background: color-mix(in srgb, var(--surface-2), var(--accent) 6%);
  }

  .name {
    display: grid;
    min-width: 0;
  }

  .name b {
    font-weight: 500;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name small {
    font-size: 12px;
    color: var(--text-3);
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
    white-space: nowrap;
  }

  .kind :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--text-3);
    flex-shrink: 0;
  }

  .pods {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--text-1);
  }

  @media (max-width: 560px) {
    .kind {
      display: none;
    }
    .head,
    li {
      grid-template-columns: minmax(0, 1fr) auto 62px;
      padding-inline: 14px;
    }
  }
</style>

<script>
  import '../../scripts/features/problems'
</script>
