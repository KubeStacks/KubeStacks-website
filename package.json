{
  "name": "kubestacks-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The website for KubeStacks, a Kubernetes app for the desktop and the cluster: kubestacks.com",
  "homepage": "https://kubestacks.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KubeStacks/KubeStacks-website.git"
  },
  "bugs": {
    "url": "https://github.com/KubeStacks/KubeStacks-website/issues"
  },
  "author": "Peter Kota <kotapeter@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:coverage": "node scripts/build-coverage.ts",
    "test": "npm run test:e2e",
    "test:e2e": "npm run build:coverage && playwright test",
    "coverage": "npm run test:e2e && nyc report",
    "coverage:report": "nyc report",
    "coverage:check": "node scripts/check-coverage.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run coverage:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "lucide-static": "^1.49.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "sharp": true
  }
}
